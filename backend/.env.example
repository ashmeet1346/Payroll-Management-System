# ==========================================
# PaySphere Backend Environment Configuration
# ==========================================

# Django Core
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Configuration (Vite React development server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL by default)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=paysphere_db
DB_USER=paysphere_user
DB_PASSWORD=your_secure_db_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Fallback to SQLite if PostgreSQL service is not reachable during local dev
AUTO_SQLITE_FALLBACK=True

# Initial Administrator Credentials (used by init_admin command)
DJANGO_SUPERUSER_USERNAME=ashmeet123
DJANGO_SUPERUSER_PASSWORD=Ashmeet@123
DJANGO_SUPERUSER_EMAIL=ashmeet@paysphere.local
