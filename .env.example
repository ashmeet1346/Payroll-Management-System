# ==============================================================================
# PAYSPHERE HR & PAYROLL SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env in your backend directory and set your local credentials:
# cp .env.example backend/.env

# Django Security
SECRET_KEY=replace_with_a_secure_random_key_for_production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Settings (Allow React Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=paysphere_db
DB_USER=paysphere_user
DB_PASSWORD=paysphere_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Automatic SQLite fallback for local development when PostgreSQL is not running
AUTO_SQLITE_FALLBACK=True

# Initial Superuser Provisioning (Optional)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=AdminPassword@123
DJANGO_SUPERUSER_EMAIL=admin@paysphere.local
